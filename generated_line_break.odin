line_break_from_rune :: proc(codepoint: rune) -> Line_Break_Class {
	page_number := int(codepoint) >> PAGE_SHIFT
	page_offset := int(codepoint) & (PAGE_SIZE - 1)
	return line_break_table[int(line_break_pages[page_number]) * PAGE_SIZE + page_offset]
}

_is_line_break :: proc(codepoint: rune, line_break: Line_Break_Class) -> bool {
	return line_break_from_rune(codepoint) == line_break
}

is_line_break_unknown :: proc(codepoint: rune) -> bool {
	return line_break_from_rune(codepoint) == .XX
}

