east_asian_width_from_rune :: proc(codepoint: rune) -> East_Asian_Width {
	page_number := int(codepoint) >> PAGE_SHIFT
	page_offset := int(codepoint) & (PAGE_SIZE - 1)
	return east_asian_width_table[int(east_asian_width_pages[page_number]) * PAGE_SIZE + page_offset]
}

_is_east_asian_width :: proc(codepoint: rune, east_asian_width: East_Asian_Width) -> bool {
	return east_asian_width_from_rune(codepoint) == east_asian_width
}

is_east_asian_width_neutral :: proc(codepoint: rune) -> bool {
	return east_asian_width_from_rune(codepoint) == .N
}

is_east_asian_width_narrow :: proc(codepoint: rune) -> bool {
	return east_asian_width_from_rune(codepoint) == .Na
}

is_east_asian_width_ambiguous :: proc(codepoint: rune) -> bool {
	return east_asian_width_from_rune(codepoint) == .A
}

is_east_asian_width_wide :: proc(codepoint: rune) -> bool {
	return east_asian_width_from_rune(codepoint) == .W
}

is_east_asian_width_halfwidth :: proc(codepoint: rune) -> bool {
	return east_asian_width_from_rune(codepoint) == .H
}

is_east_asian_width_fullwidth :: proc(codepoint: rune) -> bool {
	return east_asian_width_from_rune(codepoint) == .F
}
