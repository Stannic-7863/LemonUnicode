general_category_from_rune :: proc(codepoint: rune) -> General_Category {
	page_number := int(codepoint) >> PAGE_SHIFT
	page_offset := int(codepoint) & (PAGE_SIZE - 1)
	return general_category_table[int(general_category_pages[page_number]) * PAGE_SIZE + page_offset]
}

_is_general_category :: proc(codepoint: rune, general_category: General_Category) -> bool {
	return general_category_from_rune(codepoint) == general_category
}

is_general_category_unassigned :: proc(codepoint: rune) -> bool {
	return general_category_from_rune(codepoint) == .Cn
}

is_general_category_uppercase_letter :: proc(codepoint: rune) -> bool {
	return general_category_from_rune(codepoint) == .Lu
}

is_general_category_lowercase_letter :: proc(codepoint: rune) -> bool {
